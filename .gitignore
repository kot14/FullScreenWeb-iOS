# Xcode — keep FullScreenWeb.xcodeproj/ in git (needed to open & build).
# Only ignore user-specific bits inside it (local paths, UI state, personal schemes):
**/xcuserdata/
*.xcuserstate
*.xcuserdatad/
*.xccheckout
*.xcscmblueprint
*.moved-aside
*.hmap
# Do NOT ignore project.pbxproj or project.xcworkspace/contents.xcworkspacedata.

# Xcode — build products & local DerivedData
build/
DerivedData/
.derivedData/
*.ipa
*.dSYM.zip
*.dSYM

